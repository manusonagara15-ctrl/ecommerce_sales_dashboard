# ====================================================================
# TRADING BOT ENVIRONMENT CONFIGURATION
# Copy this file to '.env' and fill in your confidential API keys.
# NEVER share or commit your '.env' file!
# ====================================================================

# Operational Mode: 'PAPER' (safe simulation) or 'LIVE' (real money)
TRADING_MODE=PAPER

# --------------------------------------------------------------------
# OPTION A: DHAN HQ API (100% Free API for retail accounts)
# Get credentials at: https://dhanhq.co/
# --------------------------------------------------------------------
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_permanent_or_daily_access_token_here

# --------------------------------------------------------------------
# OPTION B: ANGEL ONE SMARTAPI (100% Free API)
# Get credentials at: https://smartapi.angelbroking.com/
# --------------------------------------------------------------------
ANGEL_API_KEY=your_smartapi_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_PASSWORD=your_trading_pin_or_password
ANGEL_TOTP_SECRET=your_authenticator_qr_secret_key_here

# --------------------------------------------------------------------
# OPTIONAL: TELEGRAM ALERTS (Free instant mobile notification)
# --------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
